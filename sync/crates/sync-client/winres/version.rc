// 不 include winres.h：rc.exe 在 build.rs 里调用时不一定能找到 SDK 的 include 路径。
// VERSIONINFO 需要的常量在这里直接定义，效果一样且没有路径依赖。

#pragma code_page(65001)

#define VS_VERSION_INFO   1
#define VOS_NT_WINDOWS32  0x00040004L
#define VFT_APP           0x00000001L
#define FILEFLAGSMASK_    0x3fL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK FILEFLAGSMASK_
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "WinSync"
            VALUE "FileDescription", "WinSync 文件夹同步"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "WinSync"
            VALUE "OriginalFilename", "WinSync.exe"
            VALUE "ProductName", "WinSync"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
