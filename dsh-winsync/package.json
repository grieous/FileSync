{
  "name": "dsh-winsync",
  "version": "0.9.0",
  "type": "module",
  "description": "WinSync inside DeepSeek Harness — daemon proxy, agent tools and the sync panel",
  "author": "gjn86",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/daemon.js",
    "lib/proxy.js",
    "lib/version.js",
    "lib/tools.js",
    "lib/prefs.js",
    "lib/client.js",
    "cordis.patch.yml",
    "bin/winsync-daemon.exe.gz"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "test": "node test/seed-binary.mjs",
    "test:version": "node test/version.mjs"
  }
}
